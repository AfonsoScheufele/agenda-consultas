@model DashboardViewModel
@{
    ViewData["Title"] = "Início";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Início</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-ac" asp-controller="Medicos" asp-action="Create">Novo médico</a>
        <a class="btn btn-ac text-white" asp-controller="Consultas" asp-action="Create">Nova consulta</a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat">
        <div class="stat-label">Médicos</div>
        <div class="stat-value">@Model.TotalMedicos</div>
    </div>
    <div class="stat">
        <div class="stat-label">Consultas</div>
        <div class="stat-value">@Model.TotalConsultas</div>
    </div>
    <div class="stat">
        <div class="stat-label">Agendadas</div>
        <div class="stat-value is-accent">@Model.ConsultasAgendadas</div>
    </div>
    <div class="stat">
        <div class="stat-label">Realizadas</div>
        <div class="stat-value is-ok">@Model.ConsultasRealizadas</div>
    </div>
    <div class="stat">
        <div class="stat-label">Canceladas</div>
        <div class="stat-value is-danger">@Model.ConsultasCanceladas</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Próximas consultas</h2>
            <a class="btn btn-sm btn-outline-ac" asp-controller="Consultas" asp-action="Create">Agendar</a>
        </div>
        @if (!Model.ProximasConsultas.Any())
        {
            <div class="empty-state">
                <strong>Nenhuma consulta futura</strong>
                Cadastre um médico e depois agende a primeira consulta.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-ac align-middle">
                    <thead>
                        <tr>
                            <th>Data/hora</th>
                            <th>Paciente</th>
                            <th>Médico</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.ProximasConsultas)
                    {
                        <tr>
                            <td>@c.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@c.NomePaciente</td>
                            <td>@(c.Medico?.Nome ?? "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Últimos cadastros</h2>
            <a class="btn btn-sm btn-ghost" asp-controller="Consultas" asp-action="Index">Ver todas</a>
        </div>
        @if (!Model.UltimasConsultas.Any())
        {
            <div class="empty-state">
                <strong>Ainda sem registros</strong>
                Quando houver consultas, elas aparecem aqui.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-ac align-middle">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Status</th>
                            <th>Data/hora</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.UltimasConsultas)
                    {
                        <tr>
                            <td>@c.NomePaciente</td>
                            <td>
                                @switch (c.Status)
                                {
                                    case StatusConsulta.Agendada:
                                        <span class="badge-status agendada">Agendada</span>
                                        break;
                                    case StatusConsulta.Realizada:
                                        <span class="badge-status realizada">Realizada</span>
                                        break;
                                    case StatusConsulta.Cancelada:
                                        <span class="badge-status cancelada">Cancelada</span>
                                        break;
                                }
                            </td>
                            <td>@c.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
